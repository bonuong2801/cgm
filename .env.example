# GOOGLE_API_KEY: Server-side Google Drive API v3 Key (recommended — hidden from browser).
GOOGLE_API_KEY="your_google_drive_api_key_here"

# Optional fallback if running purely static without /api backend:
# VITE_GOOGLE_API_KEY="your_google_drive_api_key_here"

# GEMINI_API_KEY: Optional server-side Gemini API Key for AI Smart Culling (/api/ai/cull).
GEMINI_API_KEY="your_gemini_api_key_here"
