# ============================================================================
# 1. SUPABASE AUTH & DATABASE (Bắt buộc cho Đăng nhập & Phân cấp Tài khoản)
# ============================================================================
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_public_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_secret_key"

# ============================================================================
# 2. THANH TOÁN TỰ ĐỘNG VIETQR (SePay hoặc PayOS Webhook)
# ============================================================================
# Mã ngân hàng chuẩn VietQR (VD: MB, VCB, TCB, ACB, BIDV, ICB, VPB, TPB...)
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0123456789"
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"

# Khóa bí mật xác thực Webhook từ SePay (Header: Authorization: Apikey <SEPAY_WEBHOOK_SECRET>)
SEPAY_WEBHOOK_SECRET="your_sepay_webhook_secret"
# Hoặc khóa Checksum nếu dùng PayOS Webhook:
PAYOS_CHECKSUM_KEY=""

# Cấu hình giá các gói Mở khóa Full (VND)
PLAN_MONTHLY_VND="99000"
PLAN_YEARLY_VND="599000"
PLAN_LIFETIME_VND="1290000"

# ============================================================================
# 3. GOOGLE DRIVE & GEMINI AI (Chỉ lưu trên Server — Ẩn khỏi trình duyệt)
# ============================================================================
GOOGLE_API_KEY="your_google_drive_api_key_here"
GEMINI_API_KEY="your_gemini_api_key_here"
