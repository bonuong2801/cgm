# VITE_GOOGLE_API_KEY: Google Drive API v3 Key for crawling public Google Drive folders.
VITE_GOOGLE_API_KEY="your_google_drive_api_key_here"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
