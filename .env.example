# ============================================================================
# 1. SUPABASE AUTH & DATABASE (Bắt buộc cho Đăng nhập & Phân cấp Tài khoản)
# ============================================================================
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_publishable_or_anon_key"
SUPABASE_WEBHOOK_RPC_SECRET="your_random_webhook_rpc_secret"

# ============================================================================
# 2. THANH TOÁN TỰ ĐỘNG VIETQR (SePay hoặc PayOS Webhook)
# ============================================================================
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0123456789"
VIETQR_ACCOUNT_NAME="NGUYEN VAN A"

SEPAY_WEBHOOK_SECRET="your_sepay_webhook_secret"
PAYOS_CHECKSUM_KEY=""

PLAN_MONTHLY_VND="29000"
PLAN_YEARLY_VND="199000"
PLAN_LIFETIME_VND="399000"

# ============================================================================
# 3. GOOGLE DRIVE (Chỉ lưu trên Server — Ẩn khỏi trình duyệt)
# ============================================================================
GOOGLE_API_KEY="your_google_drive_api_key_here"
